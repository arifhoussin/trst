<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HR Digital TV - Ad Supported</title>
  <!-- Video.js CSS -->
  <link href="https://vjs.zencdn.net/8.10.0/video-js.css" rel="stylesheet" />
  
  <style>
    /* --- বেসিক স্টাইল --- */
    body {
      background-color: #0f1216;
      color: #e0e0e0;
      font-family: 'Segoe UI', 'Bangla', sans-serif;
      margin: 0;
      padding: 15px;
    }
    .main-container {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      gap: 20px;
      background: #181c24;
      padding: 20px;
      border-radius: 16px;
      box-shadow: 0 15px 40px rgba(0,0,0,0.6);
    }
    
    .player-section {
      flex: 7;
      display: flex;
      flex-direction: column;
      position: relative; /* রিলেটিভ রাখা জরুরি */
    }

    /* --- ১. অ্যাডভার্টাইজমেন্ট ওভারলে ডিজাইন (নতুন) --- */
    #ad-overlay {
      display: none; /* শুরুতে হাইড থাকবে */
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 480px; /* ভিডিও প্লেয়ারের হাইটের সমান */
      background-color: rgba(0, 0, 0, 0.9); /* কালো ব্যাকগ্রাউন্ড */
      z-index: 500; /* লোগোর উপরে থাকবে */
      border-radius: 12px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .ad-content-box {
      width: 320px; /* অ্যাডের সাইজ */
      height: 270px;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      overflow: hidden;
      margin-bottom: 15px;
      position: relative;
    }
    
    /* অ্যাডের ছবি রেসপন্সিভ */
    .ad-content-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .ad-close-btn {
      padding: 8px 20px;
      background: #ff0000;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      font-size: 14px;
      opacity: 0.5; /* শুরুতে ডিজেবল ভাব */
      pointer-events: none; /* শুরুতে ক্লিক করা যাবে না */
      transition: all 0.3s;
    }
    .ad-close-btn.active {
      opacity: 1;
      pointer-events: all;
      background: #28a745; /* একটিভ হলে সবুজ হবে */
    }

    /* --- ওয়াটারমার্ক লোগো --- */
    .watermark-logo {
      position: absolute;
      top: 70px;
      right: 25px;
      width: 60px;
      height: auto;
      z-index: 100;
      opacity: 0.9;
      pointer-events: none;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
    }

    /* --- স্ট্যাটাস বার --- */
    .live-status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      background: #20252e;
      padding: 8px 15px;
      border-radius: 8px;
      border: 1px solid #2a303c;
    }
    
    .live-badge {
      background-color: #ff0000;
      color: white;
      padding: 4px 12px;
      border-radius: 4px;
      font-weight: bold;
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 0 10px rgba(255, 0, 0, 0.4);
    }

    .brand-title {
      font-size: 20px;
      font-weight: 800;
      color: #ffffff;
      text-transform: uppercase;
      letter-spacing: 1px;
      text-shadow: 0 0 15px rgba(0, 168, 255, 0.8);
    }
    
    .blink-dot {
      width: 8px;
      height: 8px;
      background: white;
      border-radius: 50%;
      animation: blinker 1.5s linear infinite;
    }
    @keyframes blinker { 50% { opacity: 0; } }

    .viewer-count {
      color: #bbb;
      font-size: 14px;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* --- ভিডিও প্লেয়ার --- */
    .video-js {
      width: 100% !important;
      height: 480px !important;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #2a303c;
    }
    
    .current-playing-info {
      margin-top: 15px;
      display: flex;
      align-items: center;
      gap: 15px;
      background: #20252e;
      padding: 15px;
      border-radius: 10px;
    }
    .current-logo {
      width: 50px;
      height: 50px;
      object-fit: contain;
      background: #fff;
      border-radius: 50%;
      padding: 3px;
    }
    .current-title {
      font-size: 22px;
      font-weight: 700;
      color: #fff;
    }

    /* --- সাইডবার --- */
    .sidebar-section {
      flex: 3;
      background: #13161c;
      border-radius: 12px;
      padding: 15px;
      display: flex;
      flex-direction: column;
      max-height: 600px;
      border: 1px solid #2a303c;
    }
    .sidebar-header {
      padding-bottom: 12px;
      border-bottom: 2px solid #2a303c;
      margin-bottom: 10px;
      font-weight: bold;
      color: #00a8ff;
      display: flex;
      justify-content: space-between;
    }
    
    .channel-list {
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding-right: 5px;
    }
    .channel-list::-webkit-scrollbar { width: 5px; }
    .channel-list::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }

    .channel-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px;
      border-radius: 8px;
      cursor: pointer;
      background: #1b2029;
      transition: all 0.2s;
      border: 1px solid transparent;
    }
    .channel-item:hover {
      background: #252b36;
      border-color: #00a8ff;
      transform: translateX(5px);
    }
    .channel-item.active {
      background: linear-gradient(90deg, #00a8ff 0%, #0077ff 100%);
      color: #fff;
      border: none;
    }
    
    .ch-logo-img { width: 36px; height: 36px; background: #fff; border-radius: 50%; object-fit: contain; padding: 2px; }
    .ch-placeholder { width: 36px; height: 36px; background: #333; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; color: #777; font-size: 14px; }
    .channel-item.active .ch-placeholder { background: rgba(255,255,255,0.2); color: #fff; }
    .ch-name { font-size: 14px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* রেসপনসিভ */
    @media (max-width: 768px) {
      .main-container { flex-direction: column; padding: 10px; }
      .video-js { height: 260px !important; }
      #ad-overlay { height: 260px; top: 120px; /* মোবাইলে পজিশন এডজাস্টমেন্ট */ }
      .sidebar-section { max-height: 400px; }
      .watermark-logo { width: 40px; top: 65px; right: 15px; }
      .brand-title { font-size: 14px; }
      .live-badge { font-size: 10px; padding: 4px 8px; }
    }
  </style>
</head>
<body>

<div class="main-container">
  
  <div class="player-section">
    
    <!-- লাইভ বার -->
    <div class="live-status-bar">
      <div class="live-badge"><span class="blink-dot"></span> LIVE</div>
      <div class="brand-title">HR DIGITAL TV</div>
      <div class="viewer-count">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        <span id="live-viewers">12,405</span>
      </div>
    </div>

    <!-- স্থির লোগো -->
    <img src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEg2RrInFW5EZmvJ7M9UUvyH6-6mvbNMGo9g7Yrom_N9ChNHzzwZuRZlMFhxdN68vQ3ukelLe06JNP5WXAQn47aa_Y8Y0iBwlZ15fjyj-JGoIAdxjE61I-t5S0RZhHLeyDLF4WjA_tTV2DOmLovefmEG7HD02xjLLAn9A3xBX-OKY5L3UfNRjxdJ3E7x_2I/s653/NR%20TV%20BANGLA.png" class="watermark-logo" alt="TV Logo">

    <!-- ২. অ্যাডভার্টাইজমেন্ট কন্টেইনার (ভিডিওর উপরে ভাসবে) -->
    <div id="ad-overlay">
      
      <!-- অ্যাড বসানোর বাক্স -->
      <div class="ad-content-box">
        <!-- ============================================ -->
        <!-- নিচে অ্যাডের ইমেজ লিংক বা AdSense কোড বসান -->
        <!-- ============================================ -->
        
        <a href="https://www.google.com" target="_blank">
            <img src="<script src="https://pl29667212.effectivecpmnetwork.com/ee/0d/bc/ee0dbcdd53de834ddb99fb3c36ce9d3e.js"></script>
" alt="Advertisement">
        </a>

        <!-- আপনি চাইলে উপরের <a> ট্যাগ মুছে আপনার AdSense/Iframe কোড এখানে বসাতে পারেন -->
        <!-- ============================================ -->
      </div>

      <button class="ad-close-btn" id="closeBtn" onclick="closeAd()">Please Wait 5s...</button>
    </div>
    <!-- অ্যাড কন্টেইনার শেষ -->

    <video id="iptv-player" class="video-js vjs-big-play-centered" controls preload="auto">
      <p class="vjs-no-js">JavaScript enable করুন।</p>
    </video>
    
    <div class="current-playing-info">
      <img src="" id="main-logo" class="current-logo" style="display:none;">
      <div class="current-title" id="main-title">লোড হচ্ছে...</div>
    </div>
  </div>

  <div class="sidebar-section">
    <div class="sidebar-header">
      <span>লাইভ টিভি</span>
      <span style="background:#333; padding:2px 8px; border-radius:5px; font-size:12px; color:#fff;" id="count">0</span>
    </div>
    <div class="channel-list" id="channel-list">
      <div style="text-align:center; color:#666; padding:20px;">অপেক্ষা করুন...</div>
    </div>
  </div>

</div>

<script src="https://vjs.zencdn.net/8.10.0/video.min.js"></script>

<script>
  var player = videojs('iptv-player');
  var playlistURL = "https://raw.githubusercontent.com/Rakib49/Rakibiptv/refs/heads/main/aynaott.m3u";
  var allChannels = [];

  // ============================================
  // ৩. অ্যাডভার্টাইজমেন্ট লজিক (সেটিং)
  // ============================================
  var adIntervalTime = 60000; // ৬০,০০০ মিলিসেকেন্ড = ১ মিনিট
  var adOverlay = document.getElementById('ad-overlay');
  var closeBtn = document.getElementById('closeBtn');
  var countdown;

  // প্রতি ১ মিনিট পর পর অ্যাড দেখাবে
  setInterval(function() {
    showAd();
  }, adIntervalTime);

  function showAd() {
    adOverlay.style.display = 'flex'; // অ্যাড শো করো
    closeBtn.classList.remove('active'); // বাটন ডিজেবল করো
    closeBtn.innerText = "Please Wait 5s...";
    
    // ৫ সেকেন্ড পর ক্লোজ বাটন একটিভ হবে
    var timeLeft = 5;
    countdown = setInterval(function() {
      timeLeft--;
      if (timeLeft <= 0) {
        clearInterval(countdown);
        closeBtn.classList.add('active');
        closeBtn.innerText = "Close Ad X";
      } else {
        closeBtn.innerText = "Please Wait " + timeLeft + "s...";
      }
    }, 1000);
  }

  function closeAd() {
    if (closeBtn.classList.contains('active')) {
      adOverlay.style.display = 'none'; // অ্যাড হাইড করো
    }
  }
  // ============================================
  // অ্যাড লজিক শেষ
  // ============================================


  // ভিউয়ার সিমুলেশন
  function startViewerSimulation() {
    var viewerCount = 12400;
    var display = document.getElementById('live-viewers');
    setInterval(function() {
      var change = Math.floor(Math.random() * 101) - 50; 
      viewerCount += change;
      display.innerText = viewerCount.toLocaleString();
    }, 3000);
  }
  startViewerSimulation();

  // লোগো এবং চ্যানেল লজিক (আগের মতোই)
  var logoDatabase = {
    "btv": "https://upload.wikimedia.org/wikipedia/commons/thumb/2/23/Bangladesh_Television_logo.svg/512px-Bangladesh_Television_logo.svg.png",
    "channel i": "https://upload.wikimedia.org/wikipedia/commons/thumb/8/80/Channel_i_logo.svg/512px-Channel_i_logo.svg.png",
    "ntv": "https://upload.wikimedia.org/wikipedia/en/thumb/0/05/NTV_%28Bangladesh%29_logo.svg/320px-NTV_%28Bangladesh%29_logo.svg.png",
    "rtv": "https://upload.wikimedia.org/wikipedia/en/thumb/0/0e/RTV_Logo.svg/320px-RTV_Logo.svg.png",
    "atn bangla": "https://upload.wikimedia.org/wikipedia/commons/thumb/d/d7/ATN_Bangla.svg/320px-ATN_Bangla.svg.png",
    "banglavision": "https://upload.wikimedia.org/wikipedia/en/0/02/Bangla_Vision_logo.png",
    "somoy": "https://upload.wikimedia.org/wikipedia/commons/9/9e/Somoy_TV_Logo.jpg",
    "jamuna": "https://upload.wikimedia.org/wikipedia/en/c/c8/Jamuna_Television_logo.png",
    "ekattor": "https://upload.wikimedia.org/wikipedia/commons/thumb/3/30/Ekattor_TV_Logo.svg/512px-Ekattor_TV_Logo.svg.png"
  };

  function findLogo(channelName) {
    var lowerName = channelName.toLowerCase().replace(/[^a-z0-9]/g, '');
    for (var key in logoDatabase) {
      if (lowerName.includes(key.replace(/[^a-z0-9]/g, ''))) { return logoDatabase[key]; }
    }
    return null;
  }

  async function initPlayer() {
    try {
      const response = await fetch(playlistURL);
      const text = await response.text();
      parseM3U(text);
    } catch (e) { console.error(e); }
  }

  function parseM3U(data) {
    const lines = data.split('\n');
    let current = {};
    lines.forEach(line => {
      line = line.trim();
      if (!line) return;
      if (line.startsWith('#EXTINF:')) {
        const logoMatch = line.match(/tvg-logo="(.*?)"/);
        let logo = logoMatch ? logoMatch[1] : null;
        const nameParts = line.split(',');
        const name = nameParts[nameParts.length - 1].trim();
        if (!logo || logo.length < 5) logo = findLogo(name);
        current = { name: name, logo: logo };
      } else if (!line.startsWith('#')) {
        if (current.name) {
          current.url = line;
          allChannels.push(current);
          current = {};
        }
      }
    });
    renderList();
  }

  function renderList() {
    const container = document.getElementById('channel-list');
    container.innerHTML = "";
    document.getElementById('count').innerText = allChannels.length;
    allChannels.forEach((ch, idx) => {
      const el = document.createElement('div');
      el.className = 'channel-item';
      let imgHtml = ch.logo 
        ? `<img src="${ch.logo}" class="ch-logo-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
           <div class="ch-placeholder" style="display:none">${idx+1}</div>`
        : `<div class="ch-placeholder">${ch.name.charAt(0)}</div>`;
      el.innerHTML = `${imgHtml}<div class="ch-name">${ch.name}</div>`;
      el.onclick = () => playStream(ch, el);
      container.appendChild(el);
    });
    if (allChannels.length > 0) playStream(allChannels[0], container.children[0]);
  }

  function playStream(ch, el) {
    document.querySelectorAll('.channel-item').forEach(x => x.classList.remove('active'));
    if (el) el.classList.add('active');
    document.getElementById('main-title').innerText = ch.name;
    const mainLogo = document.getElementById('main-logo');
    if (ch.logo) { mainLogo.src = ch.logo; mainLogo.style.display = 'block'; } 
    else { mainLogo.style.display = 'none'; }
    player.src({ src: ch.url, type: 'application/x-mpegURL' });
    player.play().catch(() => {});
  }

  initPlayer();
</script>
</body>
</html>
