<script>
  // প্লেয়ার সেটআপ
  var player = videojs('iptv-player');
  var playlistURL = "https://raw.githubusercontent.com/Rakib49/Rakibiptv/refs/heads/main/aynaott.m3u";
  
  // ============================================
  // ৩. ১০টি অ্যাডের অটো-রোটেশন লজিক
  // ============================================
  var currentAdIndex = 1; // শুরু হবে ১ থেকে
  var totalAds = 10;
  var adOverlay = document.getElementById('ad-overlay');
  var closeBtn = document.getElementById('closeBtn');

  // প্রতি ১ মিনিট (60000ms) পর পর অ্যাড কল হবে
  setInterval(function() {
    rotateAd();
  }, 60000); 

  // প্রথমবার পেজ লোড হওয়ার ৫ সেকেন্ড পর প্রথম অ্যাড আসবে
  setTimeout(function() {
    rotateAd();
  }, 5000);

  function rotateAd() {
    // ১. আগের সব স্লট হাইড করা
    for (var i = 1; i <= totalAds; i++) {
      document.getElementById('ad-slot-' + i).classList.remove('active-slot');
    }

    // ২. বর্তমান স্লট শো করা
    document.getElementById('ad-slot-' + currentAdIndex).classList.add('active-slot');

    // ৩. ওভারলে ওপেন করা
    adOverlay.style.display = 'flex';
    
    // ৪. ক্লোজ বাটন রিসেট
    closeBtn.classList.remove('active');
    closeBtn.innerText = "Wait 5s...";

    // ৫. ৫ সেকেন্ড কাউন্টডাউন
    var timeLeft = 5;
    var timer = setInterval(function() {
      timeLeft--;
      if(timeLeft <= 0) {
        clearInterval(timer);
        closeBtn.classList.add('active');
        closeBtn.innerText = "Close Ad [X]";
      } else {
        closeBtn.innerText = "Wait " + timeLeft + "s...";
      }
    }, 1000);

    // ৬. পরের বারের জন্য ইনডেক্স সেট করা (১-১০ এর মধ্যে ঘুরবে)
    currentAdIndex++;
    if (currentAdIndex > totalAds) {
      currentAdIndex = 1; 
    }
  }

  function closeAd() {
    if(closeBtn.classList.contains('active')) {
      adOverlay.style.display = 'none';
    }
  }
  // ============================================

  // চ্যানেল লোডিং (আগের কোড)
  async function initPlayer() {
    try {
      const response = await fetch(playlistURL);
      const text = await response.text();
      // এখানে সিম্পল পার্সিং লজিক (সংক্ষিপ্ত)
      const lines = text.split('\n');
      const container = document.getElementById('channel-list');
      let name = "";
      lines.forEach((line, idx) => {
        if(line.startsWith('#EXTINF:')) name = line.split(',')[1];
        if(line.startsWith('http') && name) {
          let div = document.createElement('div');
          div.className = 'channel-item';
          div.innerText = name;
          let url = line.trim();
          div.onclick = () => { player.src({src:url, type:'application/x-mpegURL'}); player.play(); };
          container.appendChild(div);
          if(container.children.length === 1) div.click();
          name = "";
        }
      });
    } catch (e) {}
  }
  initPlayer();
</script>

